# Select "ultralytics" for PyTorch/YOLOv8 or "onnx" for ONNX Runtime.
DEFECT_BACKEND=ultralytics
DEFECT_MODEL_PATH=models/best.pt
DEFECT_CONFIDENCE=0.35
DEFECT_IOU=0.45
DEFECT_IMAGE_SIZE=640
DEFECT_MAX_UPLOAD_BYTES=10485760
# Optional comma-separated labels. Defaults to the six NEU steel classes.
# DEFECT_CLASS_NAMES=crazing,inclusion,patches,pitted_surface,rolled-in_scale,scratches

